{
  "rewrites": [
    {
      "source": "/hotels",
      "destination": "/hotels.html"
    },
    {
      "source": "/hotels/:slug",
      "destination": "/hotel.html"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/idea",
      "destination": "/idea.html"
    },
    {
      "source": "/venues",
      "destination": "/venues.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/security",
      "destination": "/security.html"
    },
    {
      "source": "/subprocessors",
      "destination": "/subprocessors.html"
    }
  ],
  "redirects": [
    {
      "source": "/download",
      "destination": "https://apps.apple.com/kw/app/butlr/id6769944247",
      "permanent": false
    },
    {
      "source": "/portal",
      "destination": "https://portal.onebutlr.com",
      "permanent": true
    },
    {
      "source": "/portal/index.html",
      "destination": "https://portal.onebutlr.com",
      "permanent": true
    },
    {
      "source": "/portal/(.*)",
      "destination": "https://portal.onebutlr.com",
      "permanent": true
    },
    {
      "source": "/list-your-venue",
      "destination": "https://portal.onebutlr.com/list-your-venue",
      "permanent": false
    },
    {
      "source": "/list-your-venue/",
      "destination": "https://portal.onebutlr.com/list-your-venue",
      "permanent": false
    },
    {
      "source": "/godview",
      "destination": "https://portal.onebutlr.com/godview",
      "permanent": false
    },
    {
      "source": "/godview/",
      "destination": "https://portal.onebutlr.com/godview",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
